# Copy to .env.local and fill in. Do not commit .env.local.
# Stripe – secret and webhook secret must stay server-side only (Vercel env in production)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: Publishable key for frontend (safe to expose)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# For Stripe webhook to update Firestore: add Firebase service account JSON (stringified).
# Firebase Console → Project Settings → Service Accounts → Generate new private key.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
