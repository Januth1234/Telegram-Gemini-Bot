{
  "manifest_version": 3,
  "name": "Orin AI Agent",
  "version": "1.0.0",
  "description": "Let Orin AI autonomously control your browser — click, type, navigate, and screenshot any tab.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "debugger",
    "storage",
    "notifications"
  ],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "48": "icon48.png", "128": "icon128.png" }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://orinai.org/*",
      "https://www.orinai.org/*",
      "https://*.vercel.app/*",
      "http://localhost:*/*"
    ]
  },
  "icons": { "48": "icon48.png", "128": "icon128.png" }
}
