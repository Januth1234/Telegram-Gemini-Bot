{
  "name": "orin-pc-app",
  "version": "1.0.0",
  "description": "Orin AI Desktop — persistent WebView + local Python executor",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --dir",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "org.orinai.desktop",
    "productName": "Orin AI",
    "icon": "assets/icon.png",
    "files": ["main.js","preload.js","assets/**"],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  }
}
