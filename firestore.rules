rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User profile + subcollections ─────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // File library metadata — backend (Admin SDK) writes, owner can read/delete
      match /files/{fileId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if false; // only backend via Admin SDK
      }

      // Google OAuth tokens — never readable/writable by client
      match /google_tokens/{module} {
        allow read, write: if false; // only backend via Admin SDK
      }

      // Spotify + other integration tokens — never readable/writable by client
      match /integrations/{integration} {
        allow read, write: if false; // only backend via Admin SDK
      }
    }

    match /conversations/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /usage/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /pending_signups/{docId} {
      allow read, write: if request.auth != null;
    }

    match /api_keys/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /site_metrics/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Creations (social feed) ───────────────────────────────────────────────
    match /creations/{creationId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid;
        allow update: if request.auth != null;
        allow delete: if request.auth != null;
      }
    }
  }
}
