rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Existing user data (keep as is) ──────────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /conversations/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /usage/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /pending_signups/{docId} {
      allow read, write: if request.auth != null;
    }

    match /api_keys/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /site_metrics/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Creations (social feed) ───────────────────────────────────────────────
    match /creations/{creationId} {
      // Anyone can read — public feed
      allow read: if true;

      // Only signed-in users can create
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;

      // Only the owner can update or delete
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid;

      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;

      // Comments subcollection
      match /comments/{commentId} {
        // Anyone can read comments
        allow read: if true;

        // Signed-in users can add comments
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid;

        // Comment owner can update (e.g. toggle like on own comment)
        allow update: if request.auth != null;

        // Comment owner or creation owner can delete
        allow delete: if request.auth != null;
      }
    }
  }
}
