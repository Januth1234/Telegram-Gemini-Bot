rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User profile + subcollections ─────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // File library metadata — backend (Admin SDK) writes, owner can read/delete
      match /files/{fileId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if false; // only backend via Admin SDK
      }

      // Google OAuth tokens — never readable/writable by client
      match /google_tokens/{module} {
        allow read, write: if false; // only backend via Admin SDK
      }

      // Spotify + other integration tokens — never readable/writable by client
      match /integrations/{integration} {
        allow read, write: if false; // only backend via Admin SDK
      }
    }

    match /conversations/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /usage/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Password auth (managed entirely by the backend via Admin SDK) ────────
    // scrypt hashes + identifier lookup indexes must NEVER be client-readable.
    match /password_credentials/{uid} {
      allow read, write: if false;
    }
    match /auth_identifiers/{identifier} {
      allow read, write: if false;
    }

    // Server-side rate-limit counters — backend only.
    match /rate_limits/{docId} {
      allow read, write: if false;
    }

    // ── Signup requests ───────────────────────────────────────────────────────
    // Applicants see only their own request; owners/devops manage all
    // (via custom claims on their Firebase ID token).
    match /pending_signups/{docId} {
      allow get: if request.auth != null
        && (resource.data.uid == request.auth.uid
            || request.auth.token.role in ['owner', 'devops']);
      allow list: if request.auth != null
        && request.auth.token.role in ['owner', 'devops'];
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null
        && request.auth.token.role in ['owner', 'devops'];
    }

    match /api_keys/{docId} {
      allow read: if request.auth != null
        && request.auth.token.role in ['owner', 'devops'];
      allow write: if false; // generated by Cloud Function via Admin SDK only
    }

    match /site_metrics/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Creations (social feed) ───────────────────────────────────────────────
    match /creations/{creationId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid;
        // Author may edit/delete their comment; anyone signed-in may toggle
        // likes ONLY (no other field may change).
        allow update: if request.auth != null
          && (resource.data.userId == request.auth.uid
              || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']));
        allow delete: if request.auth != null
          && resource.data.userId == request.auth.uid;
      }
    }

    // Everything not matched above (broker_tasks, task_dispatch, executor_*,
    // audit_logs, login_events) is default-DENY for clients — those flows go
    // through the backend with the Admin SDK.

    // Desktop app sync blobs (Tauri client) — private per user.
    match /desktop_sync/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
